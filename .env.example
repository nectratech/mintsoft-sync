# Mintsoft API
MINTSOFT_API_URL=https://api.mintsoft.co.uk
MINTSOFT_API_KEY=
MINTSOFT_CLIENT_ID=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mintsoft_sync
DB_USERNAME=root
DB_PASSWORD=
DB_TABLE_PREFIX=ms_

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=mintsoft:

# Error Logger
ERROR_HUB_URL=https://errors.nectra.co.uk/api/ingest
ERROR_HUB_TOKEN=
ERROR_HUB_SOURCE=mintsoft-sync

# Rate Limiting
RATE_LIMIT_REQUESTS=2
RATE_LIMIT_PER_SECONDS=1

# Sync Settings
SYNC_LOOKBACK_MINUTES=30

# Ikonic API (for fetching correct external order references)
IKONIC_API_URL=https://api.ikonic.com
IKONIC_API_KEY=
