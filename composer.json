{
  "name": "nectra/mintsoft-sync",
  "description": "Mintsoft order and serial sync service",
  "type": "project",
  "require": {
    "php": "^7.4 || ^8.0",
    "predis/predis": "^1.1",
    "vlucas/phpdotenv": "^5.4",
    "monolog/monolog": "^2.9",
    "guzzlehttp/guzzle": "^7.4",
    "phpmailer/phpmailer": "^6.8"
  },
  "autoload": {
    "psr-4": {
      "MintsoftSync\\": "src/"
    }
  },
  "scripts": {
